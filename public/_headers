/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: no-store

# The typefaces carry no personal data and never change, so they may be cached.
# Everything else stays no-store, which also means a deploy takes effect at once.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# LAURA-los-003 / LAURA-sjaaccident-003. The logo was re-downloaded on every
# visit - 48 KB, on every page of a long form, on a phone.
#
# NOT max-age with immutable, which is what fonts get above. The comment there
# is right that no-store is partly why a deploy takes effect at once, and a logo
# is exactly the asset a firm asks to have changed. must-revalidate with the
# ETag Netlify already sends gives both: the browser asks, gets a 304, and
# transfers nothing - but a new logo still appears the moment it is deployed.
#
# The file is NOT being shrunk, though it is 5.4x its displayed width. The same
# asset is drawn into the PDF by pdf-builder.js, where 800px is doing real work
# at print resolution. Resizing it for the web would quietly degrade every
# claimant's document.
/apple-touch-icon.png
/favicon-32.png
/favicon.svg
  Cache-Control: public, max-age=0, must-revalidate
